# ┌──────────────────────────────────────────────────────────────────────────┐
# │ Matinee's settings, every one of them, in one file.                      │
# │                                                                          │
# │ 1. Copy this file to .env (cp example.env .env). Never commit .env.      │
# │ 2. Uncomment the lines you need: remove the "# " at the start.           │
# │ 3. Write each value straight after the =, with no spaces around it       │
# │    and no quotes:  TMDB_TOKEN=eyJhbGciOi...   not  TMDB_TOKEN = "..."    │
# │ 4. Fill in Jellyfin or Plex, not both. Or neither: Matinee then picks    │
# │    from TMDB's most popular films alone.                                 │
# │                                                                          │
# │ The least that starts Matinee: DATA_DIR and TMDB_TOKEN.                  │
# └──────────────────────────────────────────────────────────────────────────┘


# ── Where Matinee keeps its own files ─────────────────────────────────────────
# A folder Matinee owns: the film table, the profiles, the TMDB records it has
# fetched, and your own override file (overrides.json), if you write one.
# Required. The folder must exist before Matinee starts.
# DATA_DIR=/srv/matinee


# ── TMDB: film details, posters and the order to fetch them in ────────────────
# Your own TMDB "API Read Access Token" (the long one), from
# https://www.themoviedb.org/settings/api. Required for any film details: the
# rebuild fetches each film's record under your key.
# TMDB_TOKEN=

# Requests a second the rebuild sends to TMDB. 30 by default; any positive
# number. Lower it if the rebuild's log reports TMDB answering 429.
# TMDB_RATE=30

# Keep the nightly rebuild running (tools/rebuild_table.py --daily 04:30): it
# refetches each film's TMDB record before it is six months old, which keeps
# your data within TMDB's terms. Past six months Matinee keeps picking but warns
# on every screen until a rebuild refreshes it.


# ── Your library: Jellyfin OR Plex (fill in one, not both) ────────────────────
# Matinee only ever reads your library; it never writes to it.

# Jellyfin: its address and an API key (Dashboard → API Keys).
# JELLYFIN_URL=http://jellyfin.example:8096
# JELLYFIN_API_KEY=

# Plex: its address and your Plex token.
# PLEX_URL=http://plex.example:32400
# PLEX_TOKEN=

# Where the page's pictures come from: server (the default) asks your library
# for its own art, and Matinee fetches TMDB's pictures for films your library
# does not hold, so a viewer's browser talks only to Matinee; tmdb has each
# browser load every picture from TMDB.
# POSTERS_FROM=server


# ── Optional add-ons ──────────────────────────────────────────────────────────
# Seerr (Overseerr or Jellyseerr): its address. Each pick then links to "More on
# Seerr", where you can request a film you don't have. Empty: picks link to TMDB.
# SEERR_URL=https://seerr.example

# DoesTheDogDie: your API key, from https://www.doesthedogdie.com. With it, each
# viewer can keep a list of things to steer around, and every pick is checked
# against it one film at a time. Empty: no list and no check.
# DTDD_API_KEY=


# ── The door: an optional word that keeps strangers out ───────────────────────
# Set a door word and a device must give it once before it sees anything.
# Empty: every device is let in.
# DOOR_WORD=

# How closely a typed word must match: relaxed (the default) ignores case,
# spaces and punctuation, forgives one wrong letter, and needs a word of at
# least 8 letters and digits; strict must match exactly and needs at least 12
# characters.
# DOOR_MATCH=relaxed

# What the locked door says: show (the default), gin, or your own words.
# DOOR_GREETING=show
