# ┌───────────────────────────────────────────────────────────────────────────────────┐
# │ Matinee's settings, every one of them, in one file.                               │
# │                                                                                   │
# │ 1. Copy this file to .env (cp example.env .env), and never commit .env.           │
# │ 2. To switch a setting on, remove the "# " at the start of its line.              │
# │ 3. Write each value straight after the =, with no spaces around it and no quotes. │
# │    Right: TMDB_TOKEN=eyJhbGciOi...      Wrong: TMDB_TOKEN = "eyJhbGciOi..."       │
# │ 4. Where a setting shows more than one line, switch on just the one you want.     │
# │                                                                                   │
# │ To use every feature, first get the keys the README lists under "What you need".  │
# │ Under Docker, Matinee needs only TMDB_TOKEN; without Docker, DATA_DIR too.        │
# └───────────────────────────────────────────────────────────────────────────────────┘


# ═══ REQUIRED ════════════════════════════════════════════════════════════════════════

# ─── Where Matinee keeps its own files ───────────────────────────────────────────────
# A folder Matinee owns: the film table, the profiles, the TMDB records it has fetched, and your overrides.json if you write one.
# It must exist before Matinee starts, and it is the one thing to back up.
# Under Docker, leave this line as it is: Docker sets the folder to /state, and you mount your own folder there.
# Without Docker, switch it on and write your folder's path.

# DATA_DIR=/srv/matinee


# ─── TMDB: film details and posters ──────────────────────────────────────────────────
# Your TMDB "API Read Access Token": the long one, not the short API key.
# Matinee fetches every film's details under it, so without it there are no films to offer.

TMDB_TOKEN=


# ═══ OPTIONAL ════════════════════════════════════════════════════════════════════════

# ─── Your time zone ──────────────────────────────────────────────────────────────────
# The clock the nightly rebuild's time and the logs follow, named as in the tz database.
# Under Docker it is UTC unless you set it, so a rebuild at 04:30 would run at 04:30 UTC.

# TZ=America/New_York


# ─── TMDB's pace ─────────────────────────────────────────────────────────────────────
# How many requests a second the rebuild sends to TMDB: 30 by default, or any positive number.
# TMDB's own limit sits around 40 a second, so above that expect it to answer "429 Too Many Requests".
# Lower it if the rebuild's log reports a 429.

# TMDB_RATE=30


# ─── Your library: Jellyfin or Plex, never both ──────────────────────────────────────
# Fill in one, or neither: with neither, Matinee picks from TMDB's most popular films alone.
# Matinee only ever reads your library; it never changes it.
# Under Docker, localhost means Matinee's own container, not your computer.
# So write your server's network address, or its container name when both share a Docker network.

# Jellyfin: its address, and an API key made in Jellyfin's dashboard under API Keys.

# JELLYFIN_URL=http://192.168.1.20:8096
# JELLYFIN_API_KEY=

# Plex: its address, and your Plex token.
# To find the token, open any film in Plex's web app, choose ⋯ → Get Info → View XML, and copy the X-Plex-Token value from the address bar.

# PLEX_URL=http://192.168.1.20:32400
# PLEX_TOKEN=


# ─── Where posters come from: server or tmdb ─────────────────────────────────────────
# server (the default): Matinee fetches every picture itself, so a viewer's browser only ever talks to Matinee.
# Your library supplies its own art, and Matinee fetches TMDB's pictures for the films your library doesn't hold.
# tmdb: each viewer's browser loads every picture straight from TMDB, which is lighter on your server.
# With tmdb, TMDB sees each viewer's address, as any website they visit does.

# POSTERS_FROM=server
# POSTERS_FROM=tmdb


# ─── Seerr: request the films you don't have ─────────────────────────────────────────
# Overseerr or Jellyseerr. With it, each pick links to "More on Seerr", where you can request the film.
# Without it, each pick links to the film's TMDB page.
# Write the address your viewers open in their browser: Matinee sends them there, and checks that it answers.

# SEERR_URL=https://seerr.example.com


# ─── DoesTheDogDie: steer around things you'd rather not see ─────────────────────────
# Your own DoesTheDogDie API key.
# With it, each viewer can keep a list of things to steer around, and every pick is checked against that list, one film at a time.
# Without it, there's no list and no check.

# DTDD_API_KEY=


# ─── The door: a word to get in ──────────────────────────────────────────────────────
# With a door word, each device must type it once before it sees anything.
# Set one if Matinee is reachable from the internet, for example at matinee.yourdomain.com.
# Leave it empty and every device walks straight in.
# A device that got in stays in for 400 days.
# Changing the word, or DOOR_MATCH, sends every device back to the door; restarting Matinee does not.

# DOOR_WORD=


# ─── How closely a typed word must match: relaxed or strict ──────────────────────────
# relaxed (the default) ignores case, spaces and punctuation, forgives one wrong letter, and needs a word of at least 8 letters and digits.
# strict needs an exact match and a word of at least 12 characters.
# A shorter word stops Matinee from starting, and its log says why.
# A film picker guards nothing secret: the door is there to keep strangers and bots out.
# So relaxed is the default, to make getting friends and family in painless; choose strict if you'd rather.
# Either way, Matinee waits two seconds after every wrong word, which makes guessing hopelessly slow.

# DOOR_MATCH=relaxed
# DOOR_MATCH=strict


# ─── What the locked door says: show, gin, or your own words ─────────────────────────
# show (the default): "State your business. Make it quick, the show's about to start."
# gin: "State your business. And it better be sweeter than bathtub gin, or I'll feed you to the copper pipes."
# Your own words: write them straight after the =, spaces and all.

# DOOR_GREETING=show
# DOOR_GREETING=gin
# DOOR_GREETING=Knock knock. Who's there?
